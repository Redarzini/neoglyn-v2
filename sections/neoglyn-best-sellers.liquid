{% schema %}
{
  "name": "Neoglyn Best Sellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated collections for your skincare ritual"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3,
      "label": "Maximum products to show"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "View All Products"
    }
  ],
  "presets": [
    {
      "name": "Neoglyn Best Sellers"
    }
  ]
}
{% endschema %}

<section class="px-6 md:px-20 mb-20 font-display">
  <div class="flex justify-between items-end mb-8">
    <div>
      <h2 class="text-midnight text-3xl font-bold tracking-tight">{{ section.settings.heading }}</h2>
      <p class="text-midnight/60">{{ section.settings.subheading }}</p>
    </div>
    {% if section.settings.view_all_label != blank and section.settings.collection != blank %}
    <a href="{{ section.settings.collection.url }}" class="text-midnight font-bold border-b-2 border-primary pb-1 hover:text-primary transition-colors">
      {{ section.settings.view_all_label }}
    </a>
    {% endif %}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {%- assign target_collection = section.settings.collection -%}
    
    {%- if target_collection != blank and target_collection.products_count > 0 -%}
      {%- for product in target_collection.products limit: section.settings.products_to_show -%}
        <div class="group cursor-pointer">
          <a href="{{ product.url }}" class="block">
            <div class="aspect-[4/5] bg-surface rounded-2xl mb-4 overflow-hidden relative border border-surface group-hover:border-primary/50 transition-colors">
              <div class="w-full h-full bg-center bg-cover group-hover:scale-105 transition-transform duration-500" style="background-image: url('{{ product.featured_image | image_url: width: 600 }}')"></div>
              
              <form method="post" action="/cart/add" class="absolute bottom-4 right-4 z-10">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                <button type="submit" class="bg-background-light text-midnight p-3 rounded-full shadow-lg opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all hover:bg-primary border border-transparent hover:border-midnight" aria-label="Add to cart">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </button>
              </form>

              {%- if product.compare_at_price > product.price -%}
                <span class="absolute top-4 left-4 bg-primary text-midnight text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full border border-midnight">Sale</span>
              {%- endif -%}
            </div>
            
            <h3 class="font-bold text-lg text-midnight group-hover:text-primary transition-colors">{{ product.title }}</h3>
            <p class="text-midnight/60 text-sm mb-2 line-clamp-1">{{ product.description | strip_html | truncatewords: 8 }}</p>
            
            <div class="flex justify-between items-center">
              <span class="font-bold text-primary text-lg">{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <span class="text-sm line-through text-midnight/40 ml-2">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
            </div>
          </a>
        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Demo Data when no collection is selected -->
      {%- for i in (1..3) -%}
        <div class="group cursor-pointer">
          <div class="aspect-[4/5] bg-surface rounded-2xl mb-4 overflow-hidden relative border border-surface">
            <div class="w-full h-full bg-center bg-cover bg-slate-200 flex items-center justify-center text-midnight/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          </div>
          <h3 class="font-bold text-lg text-midnight">Sample Product {{ i }}</h3>
          <p class="text-midnight/60 text-sm mb-2">Configure collection in Theme Settings</p>
          <span class="font-bold text-primary text-lg">$99.00</span>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
