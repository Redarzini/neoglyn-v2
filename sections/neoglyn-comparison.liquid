{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .neoglyn-comparison {
    background-color: var(--color-background);
    color: var(--color-foreground);
    text-align: center;
  }

  .neoglyn-comparison__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .neoglyn-comparison__header {
    margin-bottom: 5rem;
  }

  .neoglyn-comparison__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 4vw, 4rem);
    font-weight: 700;
    margin: 0 0 1.5rem 0;
    color: var(--color-foreground);
  }

  .neoglyn-comparison__table {
    width: 100%;
    border-collapse: collapse;
    background-color: #FFFFFF;
    box-shadow: 0 4px 24px rgba(0, 31, 63, 0.06);
    border-radius: 8px;
    overflow: hidden;
  }

  .neoglyn-comparison__th,
  .neoglyn-comparison__td {
    padding: 2rem;
    text-align: center;
    border-bottom: 1px solid rgba(0, 31, 63, 0.1);
  }

  .neoglyn-comparison__tr:last-child .neoglyn-comparison__td {
    border-bottom: none;
  }

  /* Table Headers */
  .neoglyn-comparison__th {
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    background-color: #F8F8F8;
    color: #001F3F; /* Midnight Blue */
  }

  .neoglyn-comparison__th--feature {
    text-align: left;
    width: 40%;
  }

  .neoglyn-comparison__th--brand {
    background-color: #001F3F; /* Midnight Blue Header */
    color: #FFFFFF; 
    width: 30%;
  }

  .neoglyn-comparison__th--other {
    width: 30%;
  }

  /* Table Data */
  .neoglyn-comparison__td--feature {
    text-align: left;
    font-weight: 600;
    font-size: 1.5rem;
  }

  .neoglyn-comparison__td--brand {
    background-color: rgba(0, 31, 63, 0.02); /* Slight tint for brand column */
    font-weight: 700;
  }

  .neoglyn-comparison__icon {
    width: 24px;
    height: 24px;
    display: inline-block;
  }

  .neoglyn-comparison__check {
    fill: #82D9B9; /* Mint Checkmark */
  }

  .neoglyn-comparison__cross {
    fill: #DC3545; /* Red Cross */
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .neoglyn-comparison__th,
    .neoglyn-comparison__td {
      padding: 1.5rem 1rem;
      font-size: 1.3rem;
    }
  }
{%- endstyle -%}

<div class="neoglyn-comparison section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="neoglyn-comparison__container">
    <div class="neoglyn-comparison__header">
      <h2 class="neoglyn-comparison__heading">{{ section.settings.heading }}</h2>
    </div>

    <table class="neoglyn-comparison__table">
      <thead>
        <tr>
          <th class="neoglyn-comparison__th neoglyn-comparison__th--feature">Feature</th>
          <th class="neoglyn-comparison__th neoglyn-comparison__th--brand">Neoglyn</th>
          <th class="neoglyn-comparison__th neoglyn-comparison__th--other">Other Brands</th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr class="neoglyn-comparison__tr" {{ block.shopify_attributes }}>
            <td class="neoglyn-comparison__td neoglyn-comparison__td--feature">{{ block.settings.feature }}</td>
            
            <td class="neoglyn-comparison__td neoglyn-comparison__td--brand">
              {%- if block.settings.brand_has -%}
                <svg class="neoglyn-comparison__icon neoglyn-comparison__check" viewBox="0 0 24 24"><path d="M9 16.17-1-1-1.41-1.41 9 19 21-7-1.41-1.41z"/></svg>
              {%- else -%}
                <svg class="neoglyn-comparison__icon neoglyn-comparison__cross" viewBox="0 0 24 24"><path d="M19 6.41 17.59-5 12 10.59 6.41-5 5 6.41 10.59 12-5 17.59-1.41 1.41-12-10.59-17.59 1.41-1.41-1.41z"/></svg>
              {%- endif -%}
            </td>
            
            <td class="neoglyn-comparison__td">
              {%- if block.settings.other_has -%}
                <svg class="neoglyn-comparison__icon neoglyn-comparison__check" viewBox="0 0 24 24"><path d="M9 16.17-1-1-1.41-1.41 9 19 21-7-1.41-1.41z"/></svg>
              {%- else -%}
                <svg class="neoglyn-comparison__icon neoglyn-comparison__cross" viewBox="0 0 24 24"><path d="M19 6.41 17.59-5 12 10.59 6.41-5 5 6.41 10.59 12-5 17.59-1.41 1.41-12-10.59-17.59 1.41-1.41-1.41z"/></svg>
              {%- endif -%}
            </td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "Neoglyn Comparison",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Neoglyn"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Comparison",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature Name",
          "default": "Clinical-Grade LED Diodes"
        },
        {
          "type": "checkbox",
          "id": "brand_has",
          "label": "Neoglyn Has Feature",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "other_has",
          "label": "Other Brands Have Feature",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Neoglyn Comparison",
      "category": "Custom",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "feature": "Clinical-Grade LED Technology"
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature": "FDA Cleared for At-Home Use"
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature": "Lifetime Warranty"
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature": "Built-In Eye Protection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
