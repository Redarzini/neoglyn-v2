{% schema %}
{
  "name": "Neoglyn Spec Comparison",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Technical Specifications"
    },
    {
      "type": "text",
      "id": "brand_column_name",
      "label": "Brand Column Name",
      "default": "Flagship Device"
    },
    {
      "type": "text",
      "id": "competitor_column_name",
      "label": "Competitor Column Name",
      "default": "Industry Standard"
    }
  ],
  "blocks": [
    {
      "type": "specification",
      "name": "Specification",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature Name",
          "default": "RF Frequency"
        },
        {
          "type": "text",
          "id": "brand_value",
          "label": "Brand Value",
          "default": "1.2 MHz Multi-Polar"
        },
        {
          "type": "text",
          "id": "competitor_value",
          "label": "Competitor Value",
          "default": "0.5 MHz Mono-Polar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Neoglyn Spec Comparison",
      "blocks": [
        { "type": "specification" },
        { "type": "specification" },
        { "type": "specification" }
      ]
    }
  ]
}
{% endschema %}

<section class="py-24 px-6 md:px-20 bg-background-light font-display">
  <div class="max-w-5xl mx-auto">
    <h3 class="text-3xl font-black text-midnight mb-12 text-center">{{ section.settings.heading }}</h3>
    <div class="overflow-x-auto rounded-2xl border border-midnight">
      <table class="w-full text-left border-collapse">
        <thead class="bg-surface">
          <tr class="border-b-2 border-midnight">
            <th class="py-6 px-4 text-midnight/80 font-bold uppercase text-xs tracking-widest border-r border-midnight/10">Feature</th>
            <th class="py-6 px-4 text-midnight font-black text-lg border-r border-midnight/10">{{ section.settings.brand_column_name }}</th>
            <th class="py-6 px-4 text-midnight/60 font-bold uppercase text-xs tracking-widest">{{ section.settings.competitor_column_name }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
          <tr class="border-b border-midnight/10 hover:bg-surface/50 transition-colors" {{ block.shopify_attributes }}>
            <td class="py-5 px-4 font-bold text-midnight border-r border-midnight/10">{{ block.settings.feature }}</td>
            <td class="py-5 px-4 bg-primary/10 text-midnight font-bold border-r border-midnight/10">{{ block.settings.brand_value }}</td>
            <td class="py-5 px-4 text-midnight/40">{{ block.settings.competitor_value }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
