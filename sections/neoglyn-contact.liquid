{% schema %}
{
  "name": "Neoglyn Contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Our professional beauty experts are available 24/7 to assist you."
    }
  ],
  "presets": [
    {
      "name": "Neoglyn Contact"
    }
  ]
}
{% endschema %}

<div class="bg-background-light font-display min-h-screen py-20 px-6">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-black text-midnight mb-4">{{ section.settings.heading }}</h1>
      <p class="text-lg text-midnight/70">{{ section.settings.text }}</p>
    </div>

    <div class="bg-surface rounded-3xl p-8 md:p-12 shadow-2xl border border-surface">
      {% form 'contact', id: 'ContactForm', class: 'flex flex-col gap-6' %}
        {% if form.posted_successfully? %}
          <div class="bg-primary/20 text-midnight p-4 rounded-xl border border-primary/50 text-center font-bold">
            Thanks for reaching out! We'll get back to you soon.
          </div>
        {% elsif form.errors %}
          <div class="bg-red-500/20 text-red-900 p-4 rounded-xl border border-red-500/50 text-center font-bold">
            Please check the errors below.
          </div>
        {% endif %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex flex-col gap-2">
            <label for="ContactForm-name" class="text-midnight/80 font-bold text-sm">Name</label>
            <input class="bg-background-light border-none rounded-xl py-4 px-4 shadow-sm focus:ring-2 focus:ring-primary outline-none" autocomplete="name" type="text" id="ContactForm-name" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Name">
          </div>
          <div class="flex flex-col gap-2">
            <label for="ContactForm-email" class="text-midnight/80 font-bold text-sm">Email <span aria-hidden="true">*</span></label>
            <input
              autocomplete="email"
              type="email"
              id="ContactForm-email"
              class="bg-background-light border-none rounded-xl py-4 px-4 shadow-sm focus:ring-2 focus:ring-primary outline-none"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
              placeholder="Email"
            >
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label for="ContactForm-body" class="text-midnight/80 font-bold text-sm">Message</label>
          <textarea
            rows="6"
            id="ContactForm-body"
            class="bg-background-light border-none rounded-xl py-4 px-4 shadow-sm focus:ring-2 focus:ring-primary outline-none resize-none"
            name="contact[body]"
            placeholder="How can we help?"
          >
            {{- form.body -}}
          </textarea>
        </div>

        <button type="submit" class="bg-midnight hover:bg-primary text-white hover:text-midnight font-bold rounded-xl py-4 px-8 w-full mt-4 transition-colors">
          Send Message
        </button>
      {% endform %}
    </div>
  </div>
</div>
