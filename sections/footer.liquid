{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .neoglyn-footer {
    background-color: #001F3F; /* Midnight Blue base override */
    color: #FFFFFF;
    font-family: var(--font-body-family);
  }

  .neoglyn-footer__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .neoglyn-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    margin-bottom: 4rem;
  }

  @media screen and (min-width: 750px) {
    .neoglyn-footer__grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .neoglyn-footer__brand {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 3vw, 3.2rem);
    font-weight: 700;
    margin: 0 0 2rem 0;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
  }

  .neoglyn-footer__text {
    font-size: 1.4rem;
    line-height: 1.6;
    opacity: 0.8;
    max-width: 400px;
    margin-bottom: 3rem;
  }

  .neoglyn-footer__heading {
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 2rem 0;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    color: #82D9B9; /* Mint Accent */
  }

  .neoglyn-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .neoglyn-footer__list-item {
    margin-bottom: 1.2rem;
  }

  .neoglyn-footer__link {
    color: #FFFFFF;
    text-decoration: none;
    font-size: 1.4rem;
    opacity: 0.8;
    transition: all 0.2s ease;
  }

  .neoglyn-footer__link:hover {
    opacity: 1;
    color: #82D9B9; /* Mint highlight on hover */
    padding-left: 5px;
  }

  /* Newsletter Block */
  .neoglyn-footer__newsletter {
    margin-top: 2rem;
  }

  .neoglyn-footer__newsletter-form {
    display: flex;
    gap: 1rem;
    max-width: 400px;
  }

  .neoglyn-footer__input {
    flex-grow: 1;
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    padding: 1.2rem 1.5rem;
    border-radius: 4px;
    font-size: 1.4rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .neoglyn-footer__input:focus {
    border-color: #82D9B9;
  }

  .neoglyn-footer__input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .neoglyn-footer__btn {
    background-color: #82D9B9; /* Mint Button */
    color: #001F3F;
    border: none;
    padding: 0 2rem;
    border-radius: 4px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-transform: uppercase;
    font-size: 1.3rem;
  }

  .neoglyn-footer__btn:hover {
    background-color: #FFFFFF;
  }

  /* Bottom Bar */
  .neoglyn-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 3rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .neoglyn-footer__bottom {
      grid-template-columns: 1fr auto 1fr;
      text-align: left;
      align-items: center;
    }
  }

  .neoglyn-footer__copyright {
    font-size: 1.2rem;
    opacity: 0.6;
  }

  .neoglyn-footer__legal {
    display: flex;
    justify-content: center;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .neoglyn-footer__legal-link {
    color: #FFFFFF;
    text-decoration: none;
    font-size: 1.2rem;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .neoglyn-footer__legal-link:hover {
    opacity: 1;
    color: #82D9B9;
  }

  .neoglyn-footer__social {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .neoglyn-footer__social {
      justify-content: flex-end;
    }
  }

  .neoglyn-footer__social-icon {
    width: 20px;
    height: 20px;
    fill: #FFFFFF;
    opacity: 0.8;
    transition: all 0.2s ease;
  }

  .neoglyn-footer__social-icon:hover {
    opacity: 1;
    fill: #82D9B9;
    transform: translateY(-2px);
  }

{%- endstyle -%}

<footer class="neoglyn-footer section-{{ section.id }}-padding">
  <div class="neoglyn-footer__container">
    <div class="neoglyn-footer__grid">
      
      <!-- Brand & Newsletter -->
      <div>
        <h2 class="neoglyn-footer__brand">{{ shop.name }}</h2>
        <p class="neoglyn-footer__text">{{ section.settings.description }}</p>
        
        {%- if section.settings.show_newsletter -%}
          <div class="neoglyn-footer__newsletter">
            <h3 class="neoglyn-footer__heading" style="font-size: 1.4rem; color: #fff;">Join the List</h3>
            {% form 'customer', class: 'neoglyn-footer__newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input type="email"
                name="contact[email]"
                class="neoglyn-footer__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="Email Address"
                required
              >
              <button type="submit" class="neoglyn-footer__btn" name="commit" aria-label="Subscribe">
                Subscribe
              </button>
            {% endform %}
          </div>
        {%- endif -%}
      </div>

      <!-- Links Column 1 -->
      <div>
        <h3 class="neoglyn-footer__heading">{{ section.settings.menu_1_title }}</h3>
        {%- if section.settings.menu_1 != blank -%}
          <ul class="neoglyn-footer__list">
            {%- for link in section.settings.menu_1.links -%}
              <li class="neoglyn-footer__list-item">
                <a href="{{ link.url }}" class="neoglyn-footer__link">{{ link.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <!-- Links Column 2 -->
      <div>
        <h3 class="neoglyn-footer__heading">{{ section.settings.menu_2_title }}</h3>
        {%- if section.settings.menu_2 != blank -%}
          <ul class="neoglyn-footer__list">
            {%- for link in section.settings.menu_2.links -%}
              <li class="neoglyn-footer__list-item">
                <a href="{{ link.url }}" class="neoglyn-footer__link">{{ link.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="neoglyn-footer__bottom">
      <div class="neoglyn-footer__copyright">
        &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All Rights Reserved.
      </div>
      
      <ul class="neoglyn-footer__legal">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <li><a href="{{ policy.url }}" class="neoglyn-footer__legal-link">{{ policy.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="neoglyn-footer__social">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" class="neoglyn-footer__social-link" aria-label="Instagram">
            <svg class="neoglyn-footer__social-icon" viewBox="0 0 24 24"><path d="M7.8,2H16.2C19.4,2 22,4.6 22,7.8V16.2A5.8,5.8 0 0,1 16.2,22H7.8C4.6,22 2,19.4 2,16.2V7.8A5.8,5.8 0 0,1 7.8,2M7.6,4A3.6,3.6 0 0,0 4,7.6V16.4C4,18.39 5.61,20 7.6,20H16.4A3.6,3.6 0 0,0 20,16.4V7.6C20,5.61 18.39,4 16.4,4H7.6M17.25,5.5A1.25,1.25 0 0,1 18.5,6.75A1.25,1.25 0 0,1 17.25,8A1.25,1.25 0 0,1 16,6.75A1.25,1.25 0 0,1 17.25,5.5M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <a href="{{ settings.social_tiktok_link }}" class="neoglyn-footer__social-link" aria-label="TikTok">
            <svg class="neoglyn-footer__social-icon" viewBox="0 0 24 24"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 2.23-1.13 4.49-2.91 5.82-1.78 1.33-4.14 1.83-6.23 1.25-2.09-.58-3.9-2.22-4.63-4.24-.73-2.02-.38-4.36.93-6.07 1.31-1.7 3.49-2.58 5.6-2.51v4.06c-1.25.04-2.5.49-3.34 1.38-.84.88-1.1 2.22-.64 3.34.46 1.12 1.57 2.01 2.77 2.2 1.2.19 2.51-.15 3.39-1.01.88-.86 1.3-2.18 1.28-3.41-.03-6.19-.01-12.37-.01-18.57h3.98z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_youtube_link != blank -%}
          <a href="{{ settings.social_youtube_link }}" class="neoglyn-footer__social-link" aria-label="YouTube">
            <svg class="neoglyn-footer__social-icon" viewBox="0 0 24 24"><path d="M10,15L15.19,12L10,9V15M21.56,7.17C21.69,7.64 21.78,8.27 21.84,9.07C21.91,9.87 21.94,10.56 21.94,11.16L22,12C22,14.19 21.84,15.8 21.56,16.83C21.31,17.73 20.73,18.31 19.83,18.56C19.36,18.69 18.5,18.78 17.18,18.84C15.88,18.91 14.69,18.94 13.59,18.94L12,19C7.81,19 5.2,18.84 4.17,18.56C3.27,18.31 2.69,17.73 2.44,16.83C2.31,16.36 2.22,15.73 2.16,14.93C2.09,14.13 2.06,13.44 2.06,12.84L2,12C2,9.81 2.16,8.2 2.44,7.17C2.69,6.27 3.27,5.69 4.17,5.44C4.64,5.31 5.5,5.22 6.82,5.16C8.12,5.09 9.31,5.06 10.41,5.06L12,5C16.19,5 18.8,5.16 19.83,5.44C20.73,5.69 21.31,6.27 21.56,7.17Z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Neoglyn Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Brand Description",
      "default": "Clinical-grade LED therapy designed for your home. Discover the science of light with Neoglyn."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter Signup",
      "default": true
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Menu 1 Title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Menu 2 Title",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ]
}
{% endschema %}
