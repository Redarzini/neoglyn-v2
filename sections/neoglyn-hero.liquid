{% schema %}
{
  "name": "Neoglyn Hero",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium Home Care"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Professional-Grade Luxury, Designed for Your Daily Ritual"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Experience the transformative power of Neoglyn. Our artisan-crafted formulas bring the pinnacle of clinical excellence into the comfort of your home, curating a radiant future for your skin."
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    },
    {
      "type": "text",
      "id": "primary_btn_label",
      "label": "Primary Button Label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_label",
      "label": "Secondary Button Label",
      "default": "Discover the Ritual"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Neoglyn Hero"
    }
  ]
}
{% endschema %}

<section class="px-6 md:px-20 py-12 @container font-display">
  <div class="flex flex-col gap-8 @[864px]:flex-row items-center">
    <div class="w-full relative @[864px]:w-1/2 aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl group border border-midnight">
      <div class="absolute inset-0 grid grid-cols-2">
        <div class="bg-center bg-cover border-r-2 border-white" style="background-image: url('{{ section.settings.before_image | image_url: width: 800 | default: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBWeAGrWDAV62yx76NQWrvPSlsFLAfEm6xfShIBfHQONQRUw9z-wXIB-MB8MxunJHeLyEA-tcHEwMFdOkwuMRa9HYixAkCrf27V97XHFXSvStA90iT6G11_KbHqYJxObbO52oosBMEeoXJOn_mIbDRTafRwOGyvYXXcBefgOtjXEIr83ixwDLPZ4tME-SOkU38LrDPYmfzmIL5vDGXNdlA8WJmR9vYamakNGqcr8x0s7pi_frTGbzAJMP4QcMlRfSzn0vqmkXq9S88' }}');">
          <span class="absolute top-4 left-4 bg-midnight/50 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">Before</span>
        </div>
        <div class="bg-center bg-cover" style="background-image: url('{{ section.settings.after_image | image_url: width: 800 | default: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDzD34sr2F5quyVY3sAHoCkJsBTeLQjGqY8EJ8iTrq0d-dtlU5C8IJSgtQLNcar66LEiX0AoVO0tAhwGoB31j55bF_H0y1WsOUPD03Mw8Pq1Q8LFiAf8-I1Kfg3GMxWKJTCe4L52uMLtK8Y-EflnkYM1BtQZ3svQjCCllBbI9MtPPAAykgJuyb8e3WWAK8L40p8L7FmoCvOkA-vIkDxZ-4bMNi8dVI7L52uXiTz9tFPR5ahXShHQ_PcHT62CC0X6OdaL21u87FUDvE' }}');">
          <span class="absolute top-4 right-4 bg-primary text-midnight px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">4 Weeks After</span>
        </div>
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-midnight/40 to-transparent pointer-events-none"></div>
    </div>
    
    <div class="flex flex-col gap-6 @[864px]:w-1/2 @[864px]:pl-12">
      <div class="flex flex-col gap-4">
        <span class="text-primary font-bold tracking-widest uppercase text-sm">{{ section.settings.subheading }}</span>
        <h1 class="text-midnight text-4xl md:text-6xl font-black leading-[1.1] tracking-tight">{{ section.settings.heading }}</h1>
        <p class="text-midnight/80 text-lg md:text-xl font-normal leading-relaxed">{{ section.settings.description }}</p>
      </div>
      
      <div class="flex flex-wrap gap-4">
        {% if section.settings.primary_btn_label != blank %}
        <a href="{{ section.settings.primary_btn_link | default: '#' }}" class="flex min-w-[180px] cursor-pointer items-center justify-center rounded-lg h-14 px-8 bg-primary text-midnight text-base font-bold hover:scale-[1.02] transition-transform shadow-lg shadow-primary/20 border border-transparent">
          {{ section.settings.primary_btn_label }}
        </a>
        {% endif %}
        
        {% if section.settings.secondary_btn_label != blank %}
        <a href="{{ section.settings.secondary_btn_link | default: '#' }}" class="flex min-w-[180px] cursor-pointer items-center justify-center rounded-lg h-14 px-8 bg-background-light text-midnight text-base font-bold transition-colors border border-midnight hover:bg-surface">
          {{ section.settings.secondary_btn_label }}
        </a>
        {% endif %}
      </div>
      
      <div class="flex items-center gap-4 pt-4 border-t border-midnight/20">
        <p class="text-sm text-midnight/80 font-medium">Join 50,000+ happy customers embracing professional beauty at home.</p>
      </div>
    </div>
  </div>
</section>
