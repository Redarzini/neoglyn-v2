{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Structural Base */
  .neoglyn-hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 85vh;
    background-color: var(--color-background); /* White */
    color: var(--color-foreground); /* Midnight Blue */
    position: relative;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .neoglyn-hero {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  /* Typography overrides for the layout */
  .neoglyn-hero__content {
    flex: 1;
    padding: 4rem 2rem;
    max-width: 600px;
    z-index: 2;
  }

  @media screen and (min-width: 750px) {
    .neoglyn-hero__content {
      padding: 6rem;
    }
  }

  .neoglyn-hero__badge {
    display: inline-block;
    background-color: var(--color-foreground); 
    color: var(--color-background);
    padding: 0.5rem 1rem;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.2rem;
    margin-bottom: 2rem;
    border-radius: 2px;
  }

  .neoglyn-hero__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(3.5rem, 5vw, 6rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 2rem 0;
    color: var(--color-foreground);
  }

  .neoglyn-hero__text {
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    line-height: 1.6;
    margin-bottom: 3rem;
    opacity: 0.9;
  }

  .neoglyn-hero__button {
    display: inline-block;
    background-color: #82D9B9; /* Strict CTA Color */
    color: var(--color-foreground);
    padding: 1.5rem 4rem;
    font-size: 1.6rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .neoglyn-hero__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 31, 63, 0.15);
  }

  /* Dual Image Logic */
  .neoglyn-hero__image-container {
    flex: 1;
    position: relative;
    width: 100%;
    min-height: 50vh;
    display: flex;
  }

  @media screen and (min-width: 750px) {
    .neoglyn-hero__image-container {
      min-height: 85vh;
    }
  }

  .neoglyn-hero__image-wrapper {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
  }

  .neoglyn-hero__image-wrapper--left {
    left: 0;
  }

  .neoglyn-hero__image-wrapper--right {
    right: 0;
    border-left: 2px solid var(--color-background);
  }

  .neoglyn-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .neoglyn-hero__label {
    position: absolute;
    bottom: 2rem;
    background-color: var(--color-background);
    color: var(--color-foreground);
    padding: 0.5rem 1.5rem;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
  }

  .neoglyn-hero__image-wrapper--left .neoglyn-hero__label {
    left: 2rem;
  }

  .neoglyn-hero__image-wrapper--right .neoglyn-hero__label {
    right: 2rem;
  }

{%- endstyle -%}

<div class="neoglyn-hero section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="neoglyn-hero__content">
    {%- if section.settings.badge_text != blank -%}
      <div class="neoglyn-hero__badge">{{ section.settings.badge_text }}</div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="neoglyn-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="neoglyn-hero__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="neoglyn-hero__button">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="neoglyn-hero__image-container">
    <div class="neoglyn-hero__image-wrapper neoglyn-hero__image-wrapper--left">
      {%- if section.settings.image_left != blank -%}
        {{ section.settings.image_left | image_url: width: 1500 | image_tag: class: 'neoglyn-hero__image', loading: 'eager' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'neoglyn-hero__image placeholder-svg' }}
      {%- endif -%}
      <div class="neoglyn-hero__label">{{ section.settings.label_left }}</div>
    </div>

    <div class="neoglyn-hero__image-wrapper neoglyn-hero__image-wrapper--right">
      {%- if section.settings.image_right != blank -%}
        {{ section.settings.image_right | image_url: width: 1500 | image_tag: class: 'neoglyn-hero__image', loading: 'eager' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'neoglyn-hero__image placeholder-svg' }}
      {%- endif -%}
      <div class="neoglyn-hero__label">{{ section.settings.label_right }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Neoglyn Luxury Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "New Arrival"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your Skincare"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Experience the Neoglyn difference with our clinical-grade LED therapy.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Interactive Split Images"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left Image (Before)"
    },
    {
      "type": "text",
      "id": "label_left",
      "label": "Left Image Label",
      "default": "Before"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Right Image (After)"
    },
    {
      "type": "text",
      "id": "label_right",
      "label": "Right Image Label",
      "default": "After 4 Weeks"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Neoglyn Luxury Hero",
      "category": "Custom"
    }
  ]
}
{% endschema %}
