{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .neoglyn-instagram {
    background-color: var(--color-background);
    color: var(--color-foreground);
    text-align: center;
  }

  .neoglyn-instagram__header {
    margin-bottom: 4rem;
  }

  .neoglyn-instagram__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 700;
    margin: 0 0 1rem 0;
    color: var(--color-foreground);
  }

  .neoglyn-instagram__subheading {
    font-size: 1.6rem;
    opacity: 0.8;
  }

  .neoglyn-instagram__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    padding: 0 1rem;
  }

  @media screen and (min-width: 750px) {
    .neoglyn-instagram__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      padding: 0 5rem;
    }
  }

  .neoglyn-instagram__item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: rgba(var(--color-foreground), 0.05); /* Placeholder tint */
  }

  .neoglyn-instagram__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .neoglyn-instagram__item:hover .neoglyn-instagram__image {
    transform: scale(1.05);
  }

  .neoglyn-instagram__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 31, 63, 0.4); /* Midnight blue overlay */
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .neoglyn-instagram__item:hover .neoglyn-instagram__overlay {
    opacity: 1;
  }

  .neoglyn-instagram__icon {
    width: 32px;
    height: 32px;
    fill: #FFFFFF; /* White icon on hover */
  }

  .neoglyn-instagram__button {
    display: inline-block;
    margin-top: 5rem;
    padding: 1.2rem 3rem;
    background-color: transparent;
    color: var(--color-foreground);
    border: 2px solid var(--color-foreground);
    font-size: 1.4rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .neoglyn-instagram__button:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }
{%- endstyle -%}

<div class="neoglyn-instagram section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="neoglyn-instagram__header">
    <h2 class="neoglyn-instagram__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="neoglyn-instagram__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="neoglyn-instagram__grid">
    {%- for block in section.blocks -%}
      <a href="{{ section.settings.instagram_link }}" class="neoglyn-instagram__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: class: 'neoglyn-instagram__image', loading: 'lazy' }}
        {%- else -%}
          {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'neoglyn-instagram__image placeholder-svg' }}
        {%- endif -%}
        
        <div class="neoglyn-instagram__overlay">
          <svg class="neoglyn-instagram__icon" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </div>
      </a>
    {%- endfor -%}
  </div>

  {%- if section.settings.button_label != blank -%}
    <a href="{{ section.settings.instagram_link }}" class="neoglyn-instagram__button" target="_blank">
      {{ section.settings.button_label }}
    </a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Neoglyn Instagram Feed",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Glow"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "@Neoglyn #NeoglynSkin"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram Profile Link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Follow Us"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Social Post",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Neoglyn Instagram Feed",
      "category": "Custom",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
