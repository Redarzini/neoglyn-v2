{% schema %}
{
  "name": "Neoglyn Instagram",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Glow with Neoglyn"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Follow us @neoglyn_beauty for daily tips and results"
    }
  ],
  "blocks": [
    {
      "type": "instagram_post",
      "name": "Instagram Post",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Instagram Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Neoglyn Instagram",
      "blocks": [
        { "type": "instagram_post" },
        { "type": "instagram_post" },
        { "type": "instagram_post" },
        { "type": "instagram_post" }
      ]
    }
  ]
}
{% endschema %}

<section class="px-6 md:px-20 mb-20 font-display">
  <div class="text-center mb-12">
    <span class="text-primary font-bold tracking-widest uppercase text-sm">{{ section.settings.subheading }}</span>
    <h2 class="text-midnight text-4xl font-bold mt-2">{{ section.settings.heading }}</h2>
    <p class="text-midnight/60 mt-2">{{ section.settings.description }}</p>
  </div>
  
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link | default: '#' }}" class="aspect-square bg-surface rounded-xl overflow-hidden relative group border border-surface hover:border-primary transition-colors block" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <div class="w-full h-full bg-center bg-cover group-hover:scale-105 transition-transform duration-500" style="background-image: url('{{ block.settings.image | image_url: width: 400 }}')"></div>
        {% else %}
          <div class="w-full h-full flex justify-center items-center bg-slate-100 text-midnight/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"></rect>
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" stroke-width="2"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-width="2"></line>
            </svg>
          </div>
        {% endif %}
        
        <div class="absolute inset-0 bg-midnight/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-background-light" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        </div>
      </a>
    {% endfor %}
  </div>
</section>
