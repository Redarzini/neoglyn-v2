{% schema %}
{
  "name": "Neoglyn FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How can we help you today?"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I charge my device?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Connect the USB-C charging cable provided in the box to a standard 5V adapter."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Neoglyn FAQ"
    }
  ]
}
{% endschema %}

<div class="bg-background-light font-display min-h-screen">
  <!-- Hero Search Section -->
  <div class="bg-midnight py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl md:text-5xl font-extrabold text-background-light mb-8">{{ section.settings.heading }}</h2>
      <div class="relative max-w-2xl mx-auto">
        <div class="flex items-center bg-background-light rounded-2xl shadow-2xl overflow-hidden p-2 border-2 border-transparent focus-within:border-primary transition-colors">
          <div class="pl-4 pr-2 text-midnight/40">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          </div>
          <input class="w-full border-none focus:ring-0 text-midnight text-lg py-4 placeholder:text-midnight/40 bg-transparent outline-none" placeholder="Search for questions, orders, or device tutorials..." type="text"/>
          <button class="bg-primary hover:bg-background-light text-midnight border-2 border-primary hover:border-midnight font-bold py-3 px-8 rounded-xl transition-all mx-1">
            Search
          </button>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap justify-center items-center gap-4">
        <span class="text-background-light/60 text-sm font-bold uppercase tracking-widest">Popular:</span>
        <a class="text-primary hover:text-background-light text-sm font-bold bg-primary/10 px-4 py-1.5 rounded-full transition-colors" href="#">Getting Started</a>
        <a class="text-primary hover:text-background-light text-sm font-bold bg-primary/10 px-4 py-1.5 rounded-full transition-colors" href="#">International Shipping</a>
        <a class="text-primary hover:text-background-light text-sm font-bold bg-primary/10 px-4 py-1.5 rounded-full transition-colors" href="#">Warranty Claims</a>
      </div>
    </div>
  </div>

  <!-- Content Area -->
  <div class="max-w-4xl mx-auto px-6 py-20">
    <div class="flex flex-col gap-6">
      {% for block in section.blocks %}
        <details class="group bg-surface rounded-2xl overflow-hidden border border-surface hover:border-primary/50 transition-colors" {{ block.shopify_attributes }}>
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none py-6 px-8 text-lg text-midnight">
            <span>{{ block.settings.question }}</span>
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <div class="text-midnight/70 group-open:animate-fadeIn px-8 pb-6 leading-relaxed">
            <p>{{ block.settings.answer }}</p>
          </div>
        </details>
      {% else %}
        <!-- Demo FAQs -->
        <details class="group bg-surface rounded-2xl overflow-hidden border border-surface hover:border-primary/50 transition-colors">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none py-6 px-8 text-lg text-midnight">
             <span>How do I charge my Neoglyn Glyn Pro for the first time?</span>
             <span class="transition group-open:rotate-180">
               <svg fill="none" height="24" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
             </span>
          </summary>
          <div class="text-midnight/70 px-8 pb-6 leading-relaxed">
             <p>Before your first use, connect the USB-C charging cable provided in the box to a standard 5V adapter. Charging typically takes 2 hours for a full cycle.</p>
          </div>
        </details>
        <details class="group bg-surface rounded-2xl overflow-hidden border border-surface hover:border-primary/50 transition-colors">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none py-6 px-8 text-lg text-midnight">
             <span>Is the device waterproof?</span>
             <span class="transition group-open:rotate-180">
               <svg fill="none" height="24" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
             </span>
          </summary>
          <div class="text-midnight/70 px-8 pb-6 leading-relaxed">
             <p>Our devices are water-resistant, making them easy to wipe down with a damp cloth, but they should not be submerged in water or used in the shower.</p>
          </div>
        </details>
      {% endfor %}
    </div>

    <!-- Contact Support Box -->
    <div class="mt-16 bg-primary/10 rounded-3xl p-10 text-center border border-primary/20">
      <h3 class="text-2xl font-bold text-midnight mb-4">Still have questions?</h3>
      <p class="text-midnight/70 mb-8 max-w-lg mx-auto">If you cannot find answer to your question in our FAQ, you can always contact our professional beauty experts.</p>
      <a href="/pages/contact" class="inline-flex items-center justify-center bg-midnight text-background-light px-8 py-4 rounded-xl font-bold hover:bg-midnight/80 transition-colors">
        Contact Support Center
      </a>
    </div>
  </div>
</div>
