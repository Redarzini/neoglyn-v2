{% schema %}
{
  "name": "Neoglyn Main Product",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Clinical Grade • At-Home Technology"
    },
    {
      "type": "text",
      "id": "trust_badge_1",
      "label": "Trust Badge 1 Text",
      "default": "Free White Glove Shipping"
    },
    {
      "type": "text",
      "id": "trust_badge_2",
      "label": "Trust Badge 2 Text",
      "default": "3-Year Precision Warranty"
    },
    {
      "type": "text",
      "id": "trust_badge_3",
      "label": "Trust Badge 3 Text",
      "default": "FDA Cleared Technology"
    }
  ],
  "presets": [
    {
      "name": "Neoglyn Main Product"
    }
  ]
}
{% endschema %}

<section class="grid grid-cols-1 lg:grid-cols-2 gap-12 px-6 md:px-20 py-12 items-start font-display bg-background-light">
  <!-- Image Gallery -->
  <div class="flex flex-col gap-4">
    <div class="aspect-[4/5] w-full rounded-2xl bg-surface overflow-hidden border border-surface">
      <img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title }}" class="w-full h-full object-cover" />
    </div>
    
    {% if product.images.size > 1 %}
    <div class="grid grid-cols-4 gap-4">
      {% for image in product.images offset: 1 limit: 4 %}
        <div class="aspect-square rounded-xl bg-surface overflow-hidden border border-surface hover:border-primary transition-colors cursor-pointer">
          <img src="{{ image | image_url: width: 400 }}" alt="{{ product.title }}" class="w-full h-full object-cover hover:scale-105 transition-transform" />
        </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>

  <!-- Product Info -->
  <div class="flex flex-col gap-6 lg:sticky lg:top-28">
    <div class="flex flex-col gap-2">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-primary">{{ section.settings.subtitle }}</span>
      <h1 class="text-4xl md:text-5xl font-black text-midnight leading-tight tracking-tight">{{ product.title }}</h1>
      
      <div class="flex items-center gap-2 mt-2">
        <div class="flex text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        </div>
        <span class="text-sm font-medium text-midnight/60">4.9/5 (2,480 Reviews)</span>
      </div>
    </div>
    
    <div class="text-lg leading-relaxed text-midnight/80 product-description">
      {{ product.description }}
    </div>
    
    <div class="py-4 border-y border-midnight/10 flex items-center justify-between">
      <div>
        <span class="text-sm text-midnight/50 block font-bold uppercase">Price</span>
        <span class="text-3xl font-black text-midnight">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="text-md line-through text-midnight/40 ml-2 font-bold">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>
    </div>

    <div class="flex flex-col gap-3">
      {% form 'product', product, class: 'flex flex-col gap-3' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        
        <button type="submit" name="add" class="w-full bg-primary hover:bg-background-light text-midnight py-5 rounded-xl font-black text-lg shadow-lg shadow-primary/20 transition-all flex items-center justify-center gap-2 border-2 border-primary hover:border-midnight" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}
            ADD TO CART 
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          {% else %}
            SOLD OUT
          {% endif %}
        </button>
      {% endform %}
    </div>

    <!-- Fulfillment Badges -->
    <div class="grid grid-cols-3 gap-4 pt-6">
      <div class="flex flex-col items-center gap-2 text-center p-3 rounded-xl bg-surface border border-transparent hover:border-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
        </svg>
        <p class="text-[10px] font-bold uppercase text-midnight/70">{{ section.settings.trust_badge_1 }}</p>
      </div>
      <div class="flex flex-col items-center gap-2 text-center p-3 rounded-xl bg-surface border border-transparent hover:border-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
        </svg>
        <p class="text-[10px] font-bold uppercase text-midnight/70">{{ section.settings.trust_badge_2 }}</p>
      </div>
      <div class="flex flex-col items-center gap-2 text-center p-3 rounded-xl bg-surface border border-transparent hover:border-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        <p class="text-[10px] font-bold uppercase text-midnight/70">{{ section.settings.trust_badge_3 }}</p>
      </div>
    </div>
  </div>
</section>
