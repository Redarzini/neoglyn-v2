{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .neoglyn-quiz {
    background-color: var(--color-background);
    color: var(--color-foreground); /* Midnight Blue */
    font-family: var(--font-body-family);
  }

  .neoglyn-quiz__container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
    text-align: center;
  }

  .neoglyn-quiz__step {
    display: none;
    animation: fadeIn 0.4s ease-in-out;
  }

  .neoglyn-quiz__step.is-active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .neoglyn-quiz__progress {
    width: 100%;
    height: 6px;
    background-color: rgba(0, 31, 63, 0.1);
    border-radius: 3px;
    margin-bottom: 4rem;
    overflow: hidden;
  }

  .neoglyn-quiz__progress-bar {
    height: 100%;
    background-color: #82D9B9; /* Bright Mint */
    width: 0%;
    transition: width 0.3s ease;
  }

  .neoglyn-quiz__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 4vw, 4.5rem);
    font-weight: 700;
    margin: 0 0 2rem 0;
    color: var(--color-foreground);
    line-height: 1.2;
  }

  .neoglyn-quiz__subtitle {
    font-size: 1.6rem;
    margin-bottom: 4rem;
    opacity: 0.8;
  }

  .neoglyn-quiz__options {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .neoglyn-quiz__option {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 31, 63, 0.15);
    padding: 2rem;
    border-radius: 8px;
    font-size: 1.6rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #001F3F;
  }

  .neoglyn-quiz__option:hover {
    border-color: #82D9B9;
    background-color: rgba(130, 217, 185, 0.05);
    transform: translateY(-2px);
  }

  .neoglyn-quiz__button {
    display: inline-block;
    background-color: #82D9B9;
    color: #001F3F;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 1.6rem;
    padding: 1.6rem 4.8rem;
    border-radius: 4px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: 0.05rem;
    text-transform: uppercase;
  }

  .neoglyn-quiz__button:hover {
    background-color: #001F3F;
    color: #FFFFFF;
  }

  .neoglyn-quiz__result {
    display: none;
    padding: 4rem 2rem;
    background-color: rgba(130, 217, 185, 0.1);
    border-radius: 8px;
    margin-top: 4rem;
  }

  .neoglyn-quiz__result.is-active {
    display: block;
    animation: fadeIn 0.6s ease-in-out;
  }
{%- endstyle -%}

<div class="neoglyn-quiz section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}" data-quiz-container>
  <div class="neoglyn-quiz__container">
    
    <!-- Intro Step -->
    <div class="neoglyn-quiz__step is-active" data-step="0">
      <h2 class="neoglyn-quiz__heading">{{ section.settings.intro_heading }}</h2>
      <p class="neoglyn-quiz__subtitle">{{ section.settings.intro_subheading }}</p>
      <button class="neoglyn-quiz__button" data-quiz-start>Start Quiz</button>
    </div>

    <!-- Question Steps -->
    <div class="neoglyn-quiz__questions" data-quiz-questions style="display: none;">
      <div class="neoglyn-quiz__progress">
        <div class="neoglyn-quiz__progress-bar" data-quiz-progress></div>
      </div>

      {%- for block in section.blocks -%}
        <div class="neoglyn-quiz__step" data-step="{{ forloop.index }}" {{ block.shopify_attributes }}>
          <h3 class="neoglyn-quiz__heading">{{ block.settings.question }}</h3>
          
          <div class="neoglyn-quiz__options">
            {%- if block.settings.option_1 != blank -%}
              <button class="neoglyn-quiz__option" data-quiz-answer>{{ block.settings.option_1 }}</button>
            {%- endif -%}
            {%- if block.settings.option_2 != blank -%}
              <button class="neoglyn-quiz__option" data-quiz-answer>{{ block.settings.option_2 }}</button>
            {%- endif -%}
            {%- if block.settings.option_3 != blank -%}
              <button class="neoglyn-quiz__option" data-quiz-answer>{{ block.settings.option_3 }}</button>
            {%- endif -%}
            {%- if block.settings.option_4 != blank -%}
              <button class="neoglyn-quiz__option" data-quiz-answer>{{ block.settings.option_4 }}</button>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <!-- Result Step -->
    <div class="neoglyn-quiz__result" data-quiz-result>
      <h2 class="neoglyn-quiz__heading">{{ section.settings.result_heading }}</h2>
      <p class="neoglyn-quiz__subtitle">{{ section.settings.result_text }}</p>
      {%- if section.settings.result_link != blank and section.settings.result_button_label != blank -%}
        <a href="{{ section.settings.result_link }}" class="neoglyn-quiz__button">{{ section.settings.result_button_label }}</a>
      {%- endif -%}
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.querySelector('[data-quiz-container]');
    if (!container) return;

    const startBtn = container.querySelector('[data-quiz-start]');
    const questionsContainer = container.querySelector('[data-quiz-questions]');
    const introStep = container.querySelector('[data-step="0"]');
    const steps = container.querySelectorAll('[data-step]:not([data-step="0"])');
    const progressBar = container.querySelector('[data-quiz-progress]');
    const resultStep = container.querySelector('[data-quiz-result]');
    
    let currentStep = 0;
    const totalSteps = steps.length;

    startBtn.addEventListener('click', () => {
      introStep.classList.remove('is-active');
      questionsContainer.style.display = 'block';
      showStep(1);
    });

    const answerBtns = container.querySelectorAll('[data-quiz-answer]');
    answerBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (currentStep < totalSteps) {
          showStep(currentStep + 1);
        } else {
          showResult();
        }
      });
    });

    function showStep(stepIndex) {
      steps.forEach(step => step.classList.remove('is-active'));
      currentStep = stepIndex;
      
      const targetStep = container.querySelector(`[data-step="${currentStep}"]`);
      if (targetStep) {
        targetStep.classList.add('is-active');
        updateProgress();
      }
    }

    function updateProgress() {
      const percentage = ((currentStep - 1) / totalSteps) * 100;
      progressBar.style.width = `${percentage}%`;
    }

    function showResult() {
      questionsContainer.style.display = 'none';
      resultStep.classList.add('is-active');
    }
  });
</script>

{% schema %}
{
  "name": "Neoglyn Skin Quiz",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "intro_heading",
      "label": "Intro Heading",
      "default": "Find Your Perfect Routine"
    },
    {
      "type": "textarea",
      "id": "intro_subheading",
      "label": "Intro Subheading",
      "default": "Take our 1-minute quiz to get a customized protocol for your LED device."
    },
    {
      "type": "text",
      "id": "result_heading",
      "label": "Result Heading",
      "default": "Your Custom Protocol is Ready"
    },
    {
      "type": "textarea",
      "id": "result_text",
      "label": "Result Text",
      "default": "Based on your answers, we recommend the Ultimate Glow Bundle with a 3x weekly regimen."
    },
    {
      "type": "text",
      "id": "result_button_label",
      "label": "Result Button Label",
      "default": "Shop Your Routine"
    },
    {
      "type": "url",
      "id": "result_link",
      "label": "Result Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Quiz Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your primary skin concern?"
        },
        {
          "type": "text",
          "id": "option_1",
          "label": "Option 1",
          "default": "Fine Lines & Wrinkles"
        },
        {
          "type": "text",
          "id": "option_2",
          "label": "Option 2",
          "default": "Acne & Breakouts"
        },
        {
          "type": "text",
          "id": "option_3",
          "label": "Option 3",
          "default": "Hyperpigmentation"
        },
        {
          "type": "text",
          "id": "option_4",
          "label": "Option 4",
          "default": "Overall Dullness"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Neoglyn Skin Quiz",
      "category": "Custom",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What is your primary skin concern?",
            "option_1": "Fine Lines",
            "option_2": "Acne",
            "option_3": "Dullness",
            "option_4": ""
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is your skin type?",
            "option_1": "Oily",
            "option_2": "Dry",
            "option_3": "Combination",
            "option_4": "Sensitive"
          }
        }
      ]
    }
  ]
}
{% endschema %}
