{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .neoglyn-how-to {
    background-color: var(--color-background); /* Pure White */
    color: var(--color-foreground); /* Midnight Blue */
  }

  .neoglyn-how-to__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .neoglyn-how-to__header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .neoglyn-how-to__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 4vw, 4rem);
    font-weight: 700;
    margin: 0 0 1.5rem 0;
    color: var(--color-foreground);
  }

  .neoglyn-how-to__subheading {
    font-size: 1.6rem;
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .neoglyn-how-to__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media screen and (min-width: 750px) {
    .neoglyn-how-to__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .neoglyn-how-to__step {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .neoglyn-how-to__step-number {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: #82D9B9; /* Bright Mint */
    color: #001F3F; /* Midnight Blue */
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 2.5rem;
  }

  .neoglyn-how-to__image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 4px; /* Slight rounding for elegant design */
    margin-bottom: 2.5rem;
    background-color: rgba(var(--color-foreground), 0.05);
  }

  .neoglyn-how-to__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .neoglyn-how-to__step-title {
    font-family: var(--font-heading-family);
    font-size: 2.2rem;
    font-weight: 600;
    margin: 0 0 1rem 0;
  }

  .neoglyn-how-to__step-text {
    font-size: 1.5rem;
    line-height: 1.6;
    opacity: 0.8;
  }
{%- endstyle -%}

<div class="neoglyn-how-to section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="neoglyn-how-to__container">
    <div class="neoglyn-how-to__header">
      <h2 class="neoglyn-how-to__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="neoglyn-how-to__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="neoglyn-how-to__grid">
      {%- for block in section.blocks -%}
        <div class="neoglyn-how-to__step" {{ block.shopify_attributes }}>
          <div class="neoglyn-how-to__step-number">{{ forloop.index }}</div>
          
          <div class="neoglyn-how-to__image-wrapper">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: class: 'neoglyn-how-to__image', loading: 'lazy' }}
            {%- else -%}
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'neoglyn-how-to__image placeholder-svg' }}
            {%- endif -%}
          </div>

          <h3 class="neoglyn-how-to__step-title">{{ block.settings.title }}</h3>
          <div class="neoglyn-how-to__step-text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Neoglyn How To Use",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to Use"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Three simple steps to clinical-grade results from home."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cleanse"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Start with a freshly cleansed and dried face for optimal LED penetration."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Neoglyn How To Use",
      "category": "Custom",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Cleanse",
            "text": "Start with a freshly cleansed and dried face for optimal LED penetration."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Treatment",
            "text": "Wear the mask for a 10-minute automated session. Relax and let the light work."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Glow",
            "text": "Remove mask and follow up with your favorite serums and moisturizers."
          }
        }
      ]
    }
  ]
}
{% endschema %}
