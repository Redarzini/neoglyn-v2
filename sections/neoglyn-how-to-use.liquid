{% schema %}
{
  "name": "Neoglyn How To Use",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Neoglyn Ritual"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Simplicity meets Clinical Excellence"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Preparation"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Cleanse skin thoroughly and apply the Silver Conductive Gel to the targeted treatment zones."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Neoglyn How To Use",
      "blocks": [
        { "type": "step", "settings": { "title": "Preparation", "text": "Cleanse skin thoroughly and apply the Silver Conductive Gel to the targeted treatment zones." } },
        { "type": "step", "settings": { "title": "Treatment", "text": "Glide the flagship device in upward circular motions for 5-10 minutes across face and neck." } },
        { "type": "step", "settings": { "title": "Results", "text": "Massage remaining serum into the skin. Repeat 3 times weekly for transformative results." } }
      ]
    }
  ]
}
{% endschema %}

<section class="bg-midnight text-background-light py-24 px-6 md:px-20 font-display">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16">
      <h3 class="text-4xl font-black mb-4">{{ section.settings.heading }}</h3>
      <p class="text-primary font-bold tracking-widest uppercase text-sm">{{ section.settings.subheading }}</p>
    </div>
    
    <div class="grid md:grid-cols-{{ section.blocks.size | at_most: 3 | at_least: 1 }} gap-12">
      {% for block in section.blocks %}
      <div class="flex flex-col gap-6 group" {{ block.shopify_attributes }}>
        <div class="text-6xl font-black text-white/10 group-hover:text-primary transition-colors">0{{ forloop.index }}</div>
        <h4 class="text-xl font-bold">{{ block.settings.title }}</h4>
        <p class="text-white/60 leading-relaxed">{{ block.settings.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
