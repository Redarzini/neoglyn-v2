{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .neoglyn-dashboard {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-body-family);
  }

  .neoglyn-dashboard__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .neoglyn-dashboard__header {
    text-align: left;
    margin-bottom: 4rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(0, 31, 63, 0.1);
  }

  .neoglyn-dashboard__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 3.5vw, 3.8rem);
    font-weight: 700;
    margin: 0 0 1rem 0;
    color: var(--color-foreground);
  }

  .neoglyn-dashboard__subtitle {
    font-size: 1.6rem;
    opacity: 0.8;
    margin: 0;
  }

  .neoglyn-dashboard__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media screen and (min-width: 750px) {
    .neoglyn-dashboard__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }
  }

  /* Grid element overrides based on blocks logic */
  .neoglyn-dashboard__card {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 31, 63, 0.1);
    border-radius: 8px;
    padding: 3rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    color: #001F3F;
  }

  .neoglyn-dashboard__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 31, 63, 0.08);
  }

  .neoglyn-dashboard__card-header {
    display: flex;
    align-items: center;
    margin-bottom: 2rem;
  }

  .neoglyn-dashboard__card-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(130, 217, 185, 0.15); /* Light Mint background */
    border-radius: 50%;
    margin-right: 1.5rem;
  }

  .neoglyn-dashboard__card-icon svg {
    width: 20px;
    height: 20px;
    fill: #001F3F;
  }

  .neoglyn-dashboard__card-title {
    font-family: var(--font-heading-family);
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
  }

  .neoglyn-dashboard__card-text {
    font-size: 1.5rem;
    line-height: 1.6;
    opacity: 0.8;
    margin-bottom: 2.5rem;
    flex-grow: 1;
  }

  .neoglyn-dashboard__card-link {
    font-weight: 700;
    font-size: 1.4rem;
    color: #001F3F;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .neoglyn-dashboard__card-link::after {
    content: "→";
    margin-left: 0.8rem;
    transition: transform 0.2s ease;
    color: #82D9B9;
  }

  .neoglyn-dashboard__card:hover .neoglyn-dashboard__card-link::after {
    transform: translateX(4px);
  }

  /* Specific Highlight Card (e.g. Protocol) */
  .neoglyn-dashboard__card--highlight {
    background-color: #001F3F;
    color: #FFFFFF;
  }

  .neoglyn-dashboard__card--highlight .neoglyn-dashboard__card-title,
  .neoglyn-dashboard__card--highlight .neoglyn-dashboard__card-link {
    color: #FFFFFF;
  }

  .neoglyn-dashboard__card--highlight .neoglyn-dashboard__card-icon {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .neoglyn-dashboard__card--highlight .neoglyn-dashboard__card-icon svg {
    fill: #82D9B9;
  }

{%- endstyle -%}

<div class="neoglyn-dashboard section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="neoglyn-dashboard__container">
    
    <div class="neoglyn-dashboard__header">
      <h1 class="neoglyn-dashboard__title">
        {%- if customer -%}
          Welcome back, {{ customer.first_name | capitalize }}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h1>
      <p class="neoglyn-dashboard__subtitle">{{ section.settings.subheading }}</p>
    </div>

    <div class="neoglyn-dashboard__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="neoglyn-dashboard__card {% if block.settings.highlight %}neoglyn-dashboard__card--highlight{% endif %}" {{ block.shopify_attributes }}>
          <div>
            <div class="neoglyn-dashboard__card-header">
              <div class="neoglyn-dashboard__card-icon">
                {%- if block.settings.icon == 'protocol' -%}
                  <svg viewBox="0 0 24 24"><path d="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M17,17H7V15H17M17,13H7V11H17M17,9H7V7H17Z"/></svg>
                {%- elsif block.settings.icon == 'box' -%}
                  <svg viewBox="0 0 24 24"><path d="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L5.06,8L12,11.85L18.94,8L12,4.15M4.5,9.8V15.74L11.25,19.54V13.6L4.5,9.8M19.5,9.8L12.75,13.6V19.54L19.5,15.74V9.8Z"/></svg>
                {%- elsif block.settings.icon == 'refresh' -%}
                  <svg viewBox="0 0 24 24"><path d="M12,18A6,6 0 0,1 6,12C6,11 6.25,10.03 6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12A8,8 0 0,0 12,20V23L16,19L12,15M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,13 17.75,13.97 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12A8,8 0 0,0 12,4Z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24"><path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M11,16H13V18H11V16M12,6C10.34,6 9,7.34 9,9H11A1,1 0 0,0 12,8A1,1 0 0,0 13,9C13,10.5 11,10.25 11,12.5H13C13,11 15,10.75 15,9C15,7.34 13.66,6 12,6Z"/></svg>
                {%- endif -%}
              </div>
              <h2 class="neoglyn-dashboard__card-title">{{ block.settings.title }}</h2>
            </div>
            <div class="neoglyn-dashboard__card-text">{{ block.settings.text }}</div>
          </div>
          <span class="neoglyn-dashboard__card-link">{{ block.settings.link_label }}</span>
        </a>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Neoglyn Dashboard",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Guest Heading",
      "default": "My Neoglyn Hub"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Manage your clinical-grade routines, subscriptions, and device warranties."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "widget",
      "name": "Dashboard Widget",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "protocol", "label": "Protocol / Document" },
            { "value": "box", "label": "Orders / Box" },
            { "value": "refresh", "label": "Autopilot / Refresh" },
            { "value": "support", "label": "Support / Question" }
          ],
          "default": "protocol"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "My Protocol"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "View your personalized LED regimen and adjust settings."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Text",
          "default": "View Protocol"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Widget Link"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight Card (Midnight Blue)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Neoglyn Dashboard",
      "category": "Account",
      "blocks": [
        {
          "type": "widget",
          "settings": {
            "icon": "protocol",
            "title": "My Protocol",
            "text": "View your personalized LED regimen and daily schedule.",
            "link_label": "View Protocol",
            "highlight": true
          }
        },
        {
          "type": "widget",
          "settings": {
            "icon": "box",
            "title": "Order History",
            "text": "Track recent orders, view invoices, and register devices.",
            "link_label": "View Orders",
            "highlight": false
          }
        },
        {
          "type": "widget",
          "settings": {
            "icon": "refresh",
            "title": "Glow Autopilot",
            "text": "Manage your subscriptions for serums, masks, and accessories.",
            "link_label": "Manage Subscription",
            "highlight": false
          }
        },
        {
          "type": "widget",
          "settings": {
            "icon": "support",
            "title": "Concierge Support",
            "text": "Get 1-on-1 assistance from our skincare specialists.",
            "link_label": "Get Help",
            "highlight": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
